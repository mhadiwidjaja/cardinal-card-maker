{
  "name": "cardinal",
  "productName": "Cardinal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cardinal: Card Maker. Design trading card games on your own computer: templates, a card spreadsheet, live preview, statistics, playtesting and print-ready PDFs.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e": "node e2e/run.mjs",
    "app": "npm run build && node server/main.ts",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "fflate": "^0.8.3",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "^1.65.0",
    "rcedit": "^5.0.2",
    "rolldown": "^1.2.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
